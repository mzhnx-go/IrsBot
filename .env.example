# ── 项目 ────────────────────────────────────────────────────
# settings.PROJECT_NAME 没有默认值，缺了它后端起不来
PROJECT_NAME="IrsBot"
# local / staging / production
ENVIRONMENT=local

# ── PostgreSQL ──────────────────────────────────────────────
# ⚠️ 用 docker compose 跑时必须是 `db`（compose 网络里的服务名）。
#    compose.yml 写的是 ${POSTGRES_SERVER:-db} —— .env 里一旦设成 localhost，
#    容器内的 backend 会去连自己的 5432（空）→ 连不上库。
#    只有在宿主机上裸跑 backend（uv run fastapi ...）时才改成 localhost。
POSTGRES_SERVER=db
POSTGRES_PORT=5432
# 开发/本地使用 app；
# 测试库 test_app 由 tests/conftest.py 自动创建并覆盖此值；
# 生产环境请通过部署端环境变量指定独立库（不要提交到仓库）。
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# ── LLM Providers ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=aiza-xxx

# ── Agent ───────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
MAX_AGENT_STEPS=15
CONTEXT_MAX_TURNS=20
CONTEXT_MAX_TOKENS=120000
AGENT_TIMEOUT=120.0

# ── Embedding ───────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ── RAG ─────────────────────────────────────────────────────
ENABLE_RAG=true
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_TOP_K=3
MILVUS_URI=http://localhost:19530
# Milvus 向量集合前缀：每个环境用不同前缀，避免互相污染
#   dev=irsbot_kb   test=irsbot_kb_test   prod=irsbot_kb_prod
MILVUS_COLLECTION_PREFIX=irsbot_kb
# 知识库文件落盘根目录：每个环境指向不同目录，避免互相污染
#   测试（test_app）由 tests/conftest.py 自动覆盖为 ./uploads/kb_test
KB_FILE_STORAGE_DIR=./uploads/kb

# ── MCP ─────────────────────────────────────────────────────
ENABLE_MCP=true
MCP_TIMEOUT=30.0
MCP_MAX_RETRIES=2

# ── Skills ──────────────────────────────────────────────────
ENABLE_SKILLS=true
SKILL_DIRS=./skills

# ── 工具权限开关（安全默认：危险工具默认关闭）─────────────
# shell_execute / file_write 具备破坏力，默认不注册到 Agent。
# 需要时在 .env 设 true；启用 file_write 时建议同时配置 FILE_WRITE_ROOTS 白名单。
ENABLE_SHELL=false
ENABLE_FILE_WRITE=false
# 文件读写白名单（逗号分隔的绝对路径）。留空 = 仅允许 项目根目录 + /tmp + 系统临时目录
FILE_WRITE_ROOTS=

# ── 注册开关（安全默认：不开放自助注册）───────────────────
# ⚠️ 这只是**首次兜底值**。部署后在 /admin 页切换「单用户 / 多租户」即时生效，
#    运行时值存在 app_settings 表，**优先级高于本变量**（表里有记录时本行被忽略）。
# 关闭时 POST /api/v1/users/signup 直接 403，账号只由管理员创建
# （/admin 用户管理页，或 superuser 调 POST /api/v1/users/）。
USERS_OPEN_REGISTRATION=false

# ── Content Safety ──────────────────────────────────────────
ENABLE_CONTENT_SAFETY=false
SAFETY_KEYWORDS_FILE=./config/safety_keywords.txt

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# ── Frontend ────────────────────────────────────────────────
FRONTEND_HOST=http://localhost:5173

# ── SMTP ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=YourProjectName

# ── Security ────────────────────────────────────────────────
# SECRET_KEY / FIRST_SUPERUSER_PASSWORD: if left as "changethis" (or empty),
# the start script (scripts/start.cmd | start.sh) generates a strong random
# value on first run and persists it to .env. So you normally do NOT edit
# these by hand. The printed password is what you use for the first login.
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=[]
